# Motor LLM de FUGA (opcional). Sin nada de esto, FUGA usa la plantilla
# determinista y funciona igual.

# Elige el proveedor: bedrock | ollama | anthropic | none
FUGA_LLM=bedrock

# --- Amazon Bedrock (AWS) ---
# Las credenciales se toman de la cadena estándar del SDK (aws configure, SSO,
# variables de entorno o rol de instancia). Región: si no la pones aquí, se usa
# la de tu perfil (aws configure get region).
# AWS_REGION=us-east-2
#
# Bedrock suele exigir un INFERENCE PROFILE (prefijo us./eu./apac.), no el model
# id on-demand. Lista los tuyos con:
#   aws bedrock list-inference-profiles --query "inferenceProfileSummaries[].inferenceProfileId"
FUGA_BEDROCK_MODEL=us.anthropic.claude-3-haiku-20240307-v1:0
# NOTA: la primera vez, habilita el acceso a los modelos de Anthropic en la
# consola de Bedrock (Model access) y completa el formulario de caso de uso.

# --- Ollama (local, privacidad) ---
# FUGA_LLM=ollama
# OLLAMA_HOST=http://localhost:11434
# FUGA_OLLAMA_MODEL=llama3.1

# --- Anthropic API ---
# FUGA_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
